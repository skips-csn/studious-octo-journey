<?php

/**
 * Implements hook_preprocess_links().
 */
function civic_sub_theme_preprocess_links(&$variables) {
  if (isset($variables['theme_hook_original']) && $variables['theme_hook_original'] === 'links__contextual') {
    $variables['modifier_class'] = FALSE;
  }
}

/**
 * Implements hook_preprocess_page().
 */
function civic_sub_theme_preprocess_page(&$variables) {
  // Always attach navigation menu styles to ensure they override CivicTheme defaults
  $variables['#attached']['library'][] = 'civic_sub_theme/navigation-menu';
  
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

  if (str_contains($alias, 'anatomy-models') || str_contains($alias, 'anatomical-models')) {
    $variables['#attached']['library'][] = 'civic_sub_theme/anatomical-models';
  }

  // Matches /staff-directory and /staff-directory/*
  if (str_starts_with($alias, '/staff-directory')) {
    $variables['#attached']['library'][] = 'civic_sub_theme/staff-directory';
  }

  // Matches /staff/* (individual staff profile pages)
  if (str_starts_with($alias, '/staff/')) {
    $variables['#attached']['library'][] = 'civic_sub_theme/staff-profile';
  }
}
